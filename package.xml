<?xml version="1.0"?>
<package format="3">
  <name>robot_self_filter_oedo</name>
  <version>0.1.32</version>
  <description>Filters the robot's body out of point clouds.</description>
  <maintainer email="dash@clearpathrobotics.com">Devon Ash</maintainer>

  <license>BSD</license>

  <url type="website">http://ros.org/wiki/robot_self_filter</url>

  <author>Eitan Marder-Eppstein</author>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>filters</depend>
  <depend>sensor_msgs</depend>
  <depend>urdf</depend>
  <depend>tf2_bullet</depend>
  <depend>resource_retriever</depend>
  <depend>visualization_msgs</depend>
  <depend>pcl_ros</depend>
  <depend>pcl_conversions</depend>
  <depend>assimp</depend>
  <depend>tinyxml</depend>
  <depend>message_filters</depend>
  <depend>std_msgs</depend>
  <depend>rcutils</depend>
  <depend>rcpputils</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
